# Required secrets
AGENTGUARD_API_KEY=
AGENTGUARD_ADMIN_SECRET=
AGENTGUARD_FLASK_SECRET=
POSTGRES_PASSWORD=

# Production security
AGENTGUARD_MAX_BODY_BYTES=262144
AGENTGUARD_AUTH_SESSION_TTL=900
AGENTGUARD_CORS_ORIGINS=https://your-dashboard.example.com
AGENTGUARD_DETECTOR_FAILURE_MODE=fail_closed

# Detection
AGENTGUARD_USE_ML=false
AGENTGUARD_USE_LLM_JUDGE=false
DEEPSEEK_API_KEY=
AGENTGUARD_JUDGE_MODEL=deepseek-chat
AGENTGUARD_ML_THRESHOLD=0.85
AGENTGUARD_BLOCK_ON_AMBIGUOUS=false

# Runtime
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
