# Copie ce fichier en .env et remplis les valeurs avant `docker compose up`

# Obligatoire — génère-la avec :
#   python3 -c "import secrets; print('ag-' + secrets.token_urlsafe(32))"
AGENTGUARD_API_KEY=

# Optionnel — permet de récupérer AGENTGUARD_API_KEY via GET /api/key?admin=...
# si tu l'as perdue. Laisse vide pour désactiver complètement cet endpoint.
AGENTGUARD_ADMIN_SECRET=

# Optionnel — signe les cookies de session du dashboard. Générée
# automatiquement si absente, mais fixe-la si tu redémarres souvent le
# conteneur (sinon les cookies existants deviennent invalides à chaque restart).
AGENTGUARD_FLASK_SECRET=
