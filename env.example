# =============================================================================
# AgentGuard - Configuration Production
# =============================================================================
# Copie ce fichier en .env et remplis les valeurs avant `docker compose up`
# =============================================================================

# -----------------------------------------------------------------------------
# AUTHENTIFICATION (OBLIGATOIRE)
# -----------------------------------------------------------------------------
# Clé API principale - génère-la avec :
#   python3 -c "import secrets; print('ag-' + secrets.token_urlsafe(32))"
AGENTGUARD_API_KEY=

# Secret admin pour endpoints sensibles (rotation clés, création clients)
# Laisse vide pour désactiver complètement ces endpoints
AGENTGUARD_ADMIN_SECRET=

# Secret Flask pour signer les sessions du dashboard
# Fixe-la pour éviter l'invalidation des cookies à chaque restart
AGENTGUARD_FLASK_SECRET=

# -----------------------------------------------------------------------------
# BASE DE DONNÉES
# -----------------------------------------------------------------------------
# Type: "sqlite" (dev) ou "postgres" (prod)
AGENTGUARD_DB_TYPE=postgres
# SQLite path (ignoré si postgres)
AGENTGUARD_DB_PATH=/data/agentguard.db
# PostgreSQL connection string
DATABASE_URL=postgresql://agentguard:${POSTGRES_PASSWORD}@postgres:5432/agentguard
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# DÉTECTION - COUCHES
# -----------------------------------------------------------------------------
# Active le modèle ML (nécessite torch + transformers installés)
AGENTGUARD_USE_ML=false
# Seuil de confiance ML pour bloquer (0.0 à 1.0)
AGENTGUARD_ML_THRESHOLD=0.85
# Chemin vers le modèle ML (défaut: ./agentguard-model)
AGENTGUARD_MODEL_PATH=/app/models/prompt-injection

# Active le LLM Judge pour cas ambigus
AGENTGUARD_USE_LLM_JUDGE=false
# Clé API pour le LLM Judge (DeepSeek par défaut)
AGENTGUARD_JUDGE_API_KEY=
# URL de l'API du juge
AGENTGUARD_JUDGE_URL=https://api.deepseek.com/chat/completions
# Modèle à utiliser
AGENTGUARD_JUDGE_MODEL=deepseek-chat
# Timeout en secondes
AGENTGUARD_JUDGE_TIMEOUT=15.0
# Taille du cache Redis pour décisions juge
AGENTGUARD_JUDGE_CACHE_SIZE=2048

# Bloquer sur détection ambiguë (sinon REVIEW seulement)
AGENTGUARD_BLOCK_ON_AMBIGUOUS=false

# Mode de défaillance: "fail_closed" (bloque si détecteur down) ou "fail_open"
AGENTGUARD_DETECTOR_FAILURE_MODE=fail_closed

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Limite globale (par IP ou API key)
AGENTGUARD_RATE_LIMIT=120 per minute
# Limite spécifique pour endpoint /span
AGENTGUARD_SPAN_RATE_LIMIT=30 per minute
# Backend Redis pour rate-limit distribué (requis avec Gunicorn multi-workers)
AGENTGUARD_LIMITER_STORAGE=redis://redis:6379/0

# -----------------------------------------------------------------------------
# SÉCURITÉ RÉSEAU
# -----------------------------------------------------------------------------
# Origines CORS autorisées (séparées par virgules)
AGENTGUARD_CORS_ORIGINS=http://localhost:8080
# Taille max du body des requêtes (bytes)
AGENTGUARD_MAX_BODY_BYTES=262144
# TTL session dashboard (secondes)
AGENTGUARD_AUTH_SESSION_TTL=900

# -----------------------------------------------------------------------------
# PERFORMANCE & RESILIENCE
# -----------------------------------------------------------------------------
# Nombre de workers Gunicorn
WEB_CONCURRENCY=2
# Threads par worker
GUNICORN_THREADS=4
# Buffer max de spans si collector down
AGENTGUARD_MAX_PENDING=500
# Timeout connexion collector (secondes)
AGENTGUARD_COLLECTOR_TIMEOUT=5.0

# -----------------------------------------------------------------------------
# OBSERVABILITÉ
# -----------------------------------------------------------------------------
# Niveau de logs: DEBUG, INFO, WARNING, ERROR
AGENTGUARD_LOG_LEVEL=INFO
# Export OpenTelemetry (optionnel)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentguard
